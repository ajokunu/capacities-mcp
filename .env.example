# Capacities MCP Server Configuration

# Required: Your Capacities API key
# Get it from Capacities Settings > Capacities API
CAPACITIES_API_KEY=your_api_key_here

# Optional: Default space ID to use when not specified
# Get it from the space URL or via capacities_list_spaces tool
CAPACITIES_DEFAULT_SPACE_ID=

# Optional: Port for x-callback response server (0 = auto-assign)
CAPACITIES_CALLBACK_PORT=0
